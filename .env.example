NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (set in Vercel): NEXT_PUBLIC_SITE_URL=https://skilltrade.team

# Billing (Stripe). Leave blank until you're ready; the app shows "coming soon" instead of plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COMMUNITY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
# Server-only key used by the Stripe webhook to update a community's plan. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Slack (see SETUP.md). Leave blank to hide "Add to Slack" on the admin page.
# From api.slack.com/apps -> your app -> Basic Information -> App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# 32 random bytes, base64, used to encrypt Slack bot tokens at rest: openssl rand -base64 32
# Changing it makes stored tokens unreadable (communities would need to Add to Slack again).
SLACK_TOKEN_ENCRYPTION_KEY=
# Shared secret for the Slack retry sweep (/api/slack/outbox): openssl rand -hex 32
CRON_SECRET=
# Slack also needs SUPABASE_SERVICE_ROLE_KEY (above).
