NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (set in Vercel): NEXT_PUBLIC_SITE_URL=https://skilltrade.team

# Billing (Stripe). Leave blank until you're ready; the app shows "coming soon" instead of plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COMMUNITY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
# Server-only key used by the Stripe webhook to update a community's plan. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=
